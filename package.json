{
  "name": "react-glide-table",
  "version": "2.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zpxlffjrm/react-glide-table.git"
  },
  "bugs": {
    "url": "https://github.com/zpxlffjrm/react-glide-table/issues"
  },
  "homepage": "https://github.com/zpxlffjrm/react-glide-table#readme",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "react",
    "table",
    "datagrid",
    "data-grid",
    "headless",
    "unstyled",
    "tanstack",
    "tanstack-table",
    "virtualization",
    "virtualized",
    "typescript",
    "compound-components",
    "column-resize",
    "column-freeze",
    "sticky-columns",
    "row-span",
    "cell-selection",
    "editable",
    "tree-table",
    "clipboard"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./compound": {
      "types": "./dist/compound.d.ts",
      "import": "./dist/compound.js",
      "require": "./dist/compound.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
